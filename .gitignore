# ==============================================================================
# SkyShield AI (VarshDristhi) — Comprehensive .gitignore
# ==============================================================================

# Node.js & Frontend dependencies
node_modules/
.pnp
.pnp.js
.npm/

# Build artifacts
dist/
dist-ssr/
build/
*.local

# Environment variables & Sensitive configs
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Python cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Database files & migrations cache
*.db
*.sqlite
*.sqlite3
backend/skyshield.db

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Temporary data archives & external large datasets
*.zip
*.tar.gz
*.rar
*.7z
backend/data/imdaa/*
!backend/data/imdaa/.gitkeep
backend/data/qpe/*
!backend/data/qpe/.gitkeep
backend/data/dem/*
!backend/data/dem/.gitkeep
