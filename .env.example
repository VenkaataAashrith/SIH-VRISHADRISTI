# ==============================================================================
# SkyShield AI (VarshDristhi) — Frontend Environment Variables Template
# ==============================================================================

# Backend API Base URL
VITE_API_URL=http://localhost:8000

# Google Maps API Key (Optional: for Google Maps JavaScript API & Hybrid Satellite GIS)
# Leave empty to use default Open-Meteo & OpenStreetMap raster/vector GIS layers
VITE_GOOGLE_MAPS_API_KEY=

# OpenWeatherMap API Key (Optional: for live precipitation Doppler Radar overlays)
# Leave empty if using default synthetic Doppler radar rendering
VITE_OPENWEATHER_API_KEY=
